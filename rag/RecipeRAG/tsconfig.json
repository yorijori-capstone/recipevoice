{
  "compilerOptions": {
  "target": "ES2022",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "outDir": "dist",
  "rootDir": "src",
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "resolveJsonModule": true,
  "allowSyntheticDefaultImports": true,   // ✅ 추가
  "forceConsistentCasingInFileNames": true // ✅ 추가
},
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "snippets", "configs"]
}