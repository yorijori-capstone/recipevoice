{
  "name": "recipe-voice-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "import": "tsx scripts/import-recipes.ts",
    "db:init": "psql -U postgres -f scripts/init-db.sql",
    "clean:all": "tsx scripts/batch-clean-recipes.ts"
  },
  "dependencies": {
    "@langchain/openai": "^1.1.2",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "langchain": "^1.0.6",
    "pg": "^8.11.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.10.9",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
